# Copy this file to backend/.env and fill in your values.

# ── Flask server ───────────────────────────────────────────────
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── HuggingFace ────────────────────────────────────────────────
# Token with write access to the Space below (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_REPO_ID=niclasfw/rubber-duck-games
HF_REPO_TYPE=space
HF_DATA_DIR=data

# ── Knowledge Graph pipeline ───────────────────────────────────
# Folder ingested by default when /api/knowledge-graph/build gets no source_path.
KG_SOURCE_PATH=../test-repo
KG_OUTPUT_DIR=./artifacts
CHUNK_SIZE=400
CHUNK_OVERLAP=60
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH=64

# ── Small Language Model ───────────────────────────────────────
LLM_MODEL_ID=niclasfw/smollm3-3b-codex
LLM_DEVICE=auto
LLM_MAX_NEW_TOKENS=512
LLM_COMPLEX_MAX_NEW_TOKENS=2048
LLM_TEMPERATURE=0.7
LLM_LAZY_LOAD=true
